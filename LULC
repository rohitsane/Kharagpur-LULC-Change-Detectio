// Study Area
var aoi = table;


// ----------------------------------------
// 1. Load Sentinel-2 imagery
// ----------------------------------------

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(aoi)
  .filterDate('2018-10-01', '2018-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20));


// ----------------------------------------
// 2. Check number of images
// ----------------------------------------

print('Number of Sentinel-2 images:', s2.size());


// ----------------------------------------
// 3. Create median composite
// ----------------------------------------

var composite = s2.median();


// ----------------------------------------
// 4. Center map on Kharagpur
// ----------------------------------------

Map.centerObject(aoi, 11);


// ----------------------------------------
// 5. Display Sentinel-2 RGB
// ----------------------------------------

Map.addLayer(
  composite,
  {
    bands: ['B4', 'B3', 'B2'],
    min: 0,
    max: 3000
  },
  'Sentinel-2 RGB 2018'
);


// ----------------------------------------
// 6. Display AOI boundary
// ----------------------------------------

Map.addLayer(
  aoi.style({
    color: 'red',
    fillColor: '00000000',
    width: 2
  }),
  {},
  'Kharagpur AOI'
);
